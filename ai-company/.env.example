# gemini = Google AI Studio API | ollama = تشغيل محلي
PROVIDER=gemini
# اسم نموذج Gemma 4 بالظبط من AI Studio (أو Ollama لو محلي) - مطلوب
MODEL_NAME=
API_KEY=your_google_ai_studio_api_key_here
OLLAMA_URL=http://localhost:11434
# كود دخول للموقع (مهم جدًا في الإنتاج عشان محدش يستهلك الـ API بتاعك)
APP_PASSWORD=
PORT=3000
# 1 لو الموقع ورا Nginx/Cloudflare (عشان الـ rate limit يشوف IP الحقيقي)
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=40
MAX_PROMPT_CHARS=30000
DATA_DIR=./data
